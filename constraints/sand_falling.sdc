#**************************************************************
# sand_falling timing constraints (DE10-Lite, Intel MAX 10).
#
# Two asynchronous clock domains from pll_sys (rtl/platform/pll_sys.sv):
#   clk[0] = clk_100  - system / CA engine domain
#   clk[2] = clk_25   - VGA pixel domain
# (clk[1] = clk_100_shift is generated by the PLL but unused in this
#  BRAM-only design - it existed for the now-removed SDRAM clock-out.)
#
# SDRAM constraints (generated DRAM clock, I/O delays, multicycle read
# window) were removed with the SDRAM controller.
#**************************************************************

#**************************************************************
# Create Clock
#**************************************************************
create_clock -period "50.0 MHz" [get_ports MAX10_CLK1_50]

#**************************************************************
# Create Generated Clock
#**************************************************************
derive_pll_clocks

#**************************************************************
# Set Clock Uncertainty
#**************************************************************
derive_clock_uncertainty

#**************************************************************
# Set Clock Groups
#**************************************************************
# clk_100 (c0) and clk_25 (c2) are asynchronous (see docs/CONVENTIONS.md
# "Clock domains"). The only signal crossing between them is the
# single-bit double-buffer "front select" flag, resynchronized with a
# 2-FF synchronizer in the clk_25 domain - the standard CDC treatment,
# correctly cut from STA here rather than analyzed as a timed path.
#
# Clock names confirmed from the Fitter's derive_pll_clocks output for
# this altpll instance (pll_inst inside top-level u_pll; see
# rtl/platform/pll_sys.sv).
set_clock_groups -asynchronous \
  -group [get_clocks {u_pll|pll_inst|auto_generated|pll1|clk[0]}] \
  -group [get_clocks {u_pll|pll_inst|auto_generated|pll1|clk[2]}]

#**************************************************************
# Set False Path
#**************************************************************
# KEY[0] is the async reset source (active-low, pressed = reset; see
# docs/CONVENTIONS.md "Reset strategy"). It fans out only to the
# arst/arst_n inputs of pll_sys and the reset_sync instances;
# metastability on deassertion is handled by reset_sync's 2-FF
# synchronizers, not by timing, so all paths from this pin are false.
set_false_path -from [get_ports {KEY[0]}]

# KEY[1] is an async push-button (brush / clear) synchronized through
# debounce.sv's 2-FF synchronizer - false path like KEY[0].
set_false_path -from [get_ports {KEY[1]}]

# SW[9:0] slide switches feed control logic sampled only at frame
# boundaries; static during normal operation, so any setup violation
# just delays one frame - false path.
set_false_path -from [get_ports {SW[*]}]

# UART_RX is an async external serial input (GPIO debug dongle);
# uart_rx.sv synchronizes it with a 2-FF synchronizer - false path.
set_false_path -from [get_ports {UART_RX}]

# GSENSOR_SDO is an async SPI MISO input from the ADXL345 accelerometer;
# sampled on SPI clock edges generated by adxl345_spi.sv - false path.
set_false_path -from [get_ports {GSENSOR_SDO}]

# GSENSOR_INT pins are async interrupt outputs from the ADXL345;
# currently unused but mapped in the QSF - false path.
set_false_path -from [get_ports {GSENSOR_INT[*]}]
